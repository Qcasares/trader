# =========================================================================
# Systematic trading engine
# =========================================================================

# PostgreSQL database connection string
DATABASE_URL=postgresql://user:password@localhost:5432/trader

# Logging level
LOG_LEVEL=INFO

# Optional, and read by two different things — set it once, here.
#
#   * `src/llm/commentary.py`, which reads decisions already made and writes
#     prose about them. Absent, commentary is skipped and nothing else changes.
#   * `src/programme/main.py`, the AI programme. Absent, the runner still
#     reconciles experiments, evaluates gates and promotes candidates; it simply
#     proposes nothing new. See the programme section below for the second
#     switch it also needs.
#
# `tests/unit/test_import_boundaries.py` guarantees neither is reachable from
# code that can place an order.
#
# This was assigned twice in this file, once per consumer. A `.env` is
# last-assignment-wins, so filling in the first and leaving the second blank
# produced an empty key and a programme that quietly proposed nothing.
ANTHROPIC_API_KEY=

# Optional. Only used by src/bankr_client.py, the reference client kept for a
# future crypto broker adapter. Nothing in the engine reads it today.
BANKR_API_KEY=

# =========================================================================
# Systematic engine — API and worker
# =========================================================================

# Postgres. DATABASE_URL is defined above and is required by both the API
# and the worker. Under docker-compose it is built from POSTGRES_PASSWORD
# instead, so set that rather than editing DATABASE_URL.
POSTGRES_PASSWORD=

# Encrypts credentials set from the UI and stored in the `secrets` table.
# Generate with:
#   python -m src.db.secrets_cli keygen
#
# Give it to the API, which writes secrets, and to the programme, which uses
# them. docker-compose deliberately blanks it for the WORKER: that process holds
# the broker credentials and submits orders, so it is the one component that
# must not be able to decrypt a model key even though it can read every row.
#
# Empty is supported. Nothing can be set from the UI without it, and the
# programme falls back to ANTHROPIC_API_KEY above — which is how every
# deployment worked before this existed.
#
# Rotating it does NOT re-encrypt what is stored: existing secrets stop
# decrypting and must be set again. The programme logs exactly that rather than
# a generic failure.
SECRETS_KEY=

# Session signing key. REQUIRED, no default — a signing key with a fallback
# value is a signing key an attacker already knows. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Operator password, bcrypt-hashed. REQUIRED. Generate with:
#   python -c "import bcrypt;print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=

# Where the browser app is served from, for CORS. Note that 127.0.0.1 and
# localhost are different origins — they must match what the browser uses.
CORS_ORIGINS=http://localhost:3000

# SameSite on the session cookie: lax, strict, or none.
#
# `lax` is correct while the UI and the API are the same *site*, which includes
# different ports — localhost:3000 calling localhost:8000 is fine.
#
# Set it to `none` when they are on different sites, which is the deployed
# topology: the frontend on Vercel, the API on its own host. A browser will not
# attach a `Lax` cookie to a cross-site request, and the symptom is misleading —
# login returns 200 and every call after it gets 401, so a correct password
# looks rejected. `none` implies Secure, which the API sets for you.
SESSION_COOKIE_SAMESITE=lax

# Reaching a live venue takes THREE independent conditions. Leave all three
# as they are. The database kill switch is a fourth, and it fails closed.
#   1. the deployment row's mode is 'live'
#   2. LIVE_TRADING_ENABLED below
#   3. ALPACA_ALLOW_LIVE below
# Two variables rather than one on purpose: the broker factory used to derive
# the third from the second, which meant a single stray flag was enough.
LIVE_TRADING_ENABLED=false
ALPACA_ALLOW_LIVE=false

# Alpaca paper credentials (Phase 3; unused today).
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# =========================================================================
# Serverless deployment
#
# Only relevant where nothing long-lived can exist — the Vercel deployment.
# Leave both alone anywhere a worker process runs.
# =========================================================================

# Let the API run queued RESEARCH jobs itself.
#
# Required on a serverless host: no worker can exist there, so without this a
# submitted backtest sits queued forever while the UI honestly reports
# "waiting for a worker" and nothing ever arrives.
#
# Must stay false anywhere a worker does run. A backtest is CPU-bound pandas
# work, and running one inside a request handler on a long-lived server stalls
# every other request on that event loop — including the one an operator is
# using to hit the kill switch.
#
# It never covers trading jobs. `live_decision` and `submit_orders` are not
# drainable, because the worker being the only process that can reach a venue
# is what makes the kill-switch check and the three gates above mean anything.
SERVERLESS_DRAIN_ENABLED=false

# Lets a scheduler (Vercel Cron) call the drain endpoint without an operator
# session, as a bearer token. Empty disables that route in entirely.
CRON_SECRET=

# =========================================================================
# Tuning — every one of these has a working default
# =========================================================================

# Connection pool bounds.
#
# The defaults suit one long-lived process holding one pool. They are wrong on
# a serverless host, where every cold start builds its own and none of them
# share: ten warm instances mean up to a hundred connections against a managed
# free tier that allows a fraction of that. Set the maximum to 3 there, and
# prefer the provider's pooled endpoint — Neon and Supabase both publish one.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# How long an operator session lasts. Sessions are signed rather than stored,
# so they cannot be revoked individually before this elapses; rotating
# SESSION_SECRET invalidates all of them at once.
SESSION_TTL_SECONDS=43200

# Worker identity and poll interval. The identity appears in
# `worker_heartbeats`, which is how the System page tells a live worker from a
# dead one; give each worker its own if you run more than one.
WORKER_ID=worker-1
WORKER_POLL_SECONDS=2

# =========================================================================
# The AI programme
# =========================================================================

# The programme is a third process, `python -m src.programme.main`, and the
# only one permitted to hold a model client. It proposes hypotheses, queues the
# experiments its gates require, and promotes candidates whose evidence is
# complete. It cannot place an order: `tests/unit/test_import_boundaries.py`
# refuses to let `src/programme` import `src.execution` or `src.worker`.
#
# It is off until two independent things say otherwise: the `programme_enabled`
# row in `system_flags`, which fails closed exactly like the kill switch, and
# ANTHROPIC_API_KEY, which is set once at the top of this file rather than again
# here. Without the key the runner still reconciles experiments, evaluates gates
# and promotes candidates — it simply proposes nothing new.

# PROGRAMME_MODEL and PROGRAMME_TICK_SECONDS used to be set here. They are now
# settings in the control plane, on System > Configuration, stored in
# `system_flags` and re-read on every pass — alongside the effort level and the
# token ceiling, which never had environment variables at all. Neither name is
# listed below because setting it would now change nothing, and a name in this
# file that changes nothing is a lie with a long half-life.
#
# The API key stays. It is a credential, and a credential belongs in the
# environment of the one process permitted to hold it rather than in a database
# row the control plane can read back.
