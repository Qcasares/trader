# bankr.bot API key — obtain from https://bankr.bot/api
BANKR_API_KEY=bk_your_key_here

# Twitter/X Developer API — https://developer.twitter.com
TWITTER_BEARER_TOKEN=your_bearer_token_here

# CoinGecko Demo API key (free) — https://www.coingecko.com/en/api
COINGECKO_API_KEY=CG-your_key_here

# Neynar API key for Farcaster — https://neynar.com
NEYNAR_API_KEY=your_neynar_key_here

# Anthropic API key for agent intelligence
ANTHROPIC_API_KEY=sk-ant-your_key_here

# PostgreSQL database connection string
DATABASE_URL=postgresql://user:password@localhost:5432/trader

# Dry run mode — set to "false" only for live trading
DRY_RUN=true

# Default chain for trades
DEFAULT_CHAIN=Base

# Logging level
LOG_LEVEL=INFO

# =========================================================================
# Systematic engine — API and worker
# =========================================================================

# Postgres. DATABASE_URL is defined above and is required by both the API
# and the worker. Under docker-compose it is built from POSTGRES_PASSWORD
# instead, so set that rather than editing DATABASE_URL.
POSTGRES_PASSWORD=

# Session signing key. REQUIRED, no default — a signing key with a fallback
# value is a signing key an attacker already knows. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Operator password, bcrypt-hashed. REQUIRED. Generate with:
#   python -c "import bcrypt;print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=

# Where the browser app is served from, for CORS. Note that 127.0.0.1 and
# localhost are different origins — they must match what the browser uses.
CORS_ORIGINS=http://localhost:3000

# Outer gate for real money. Leave false. The database kill switch is the
# inner gate; BOTH must permit trading before a live order can be placed.
LIVE_TRADING_ENABLED=false

# Alpaca paper credentials (Phase 3; unused today).
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
