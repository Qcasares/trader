# =========================================================================
# Systematic trading engine
# =========================================================================

# PostgreSQL database connection string
DATABASE_URL=postgresql://user:password@localhost:5432/trader

# Logging level
LOG_LEVEL=INFO

# Optional. Commentary only — the model reads decisions that have already
# been made and writes prose about them. Absent, commentary is skipped and
# nothing else changes; tests/unit/test_import_boundaries.py guarantees no
# code path from a model to an order.
ANTHROPIC_API_KEY=

# Optional. Only used by src/bankr_client.py, the reference client kept for a
# future crypto broker adapter. Nothing in the engine reads it today.
BANKR_API_KEY=

# =========================================================================
# Systematic engine — API and worker
# =========================================================================

# Postgres. DATABASE_URL is defined above and is required by both the API
# and the worker. Under docker-compose it is built from POSTGRES_PASSWORD
# instead, so set that rather than editing DATABASE_URL.
POSTGRES_PASSWORD=

# Session signing key. REQUIRED, no default — a signing key with a fallback
# value is a signing key an attacker already knows. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Operator password, bcrypt-hashed. REQUIRED. Generate with:
#   python -c "import bcrypt;print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=

# Where the browser app is served from, for CORS. Note that 127.0.0.1 and
# localhost are different origins — they must match what the browser uses.
CORS_ORIGINS=http://localhost:3000

# Reaching a live venue takes THREE independent conditions. Leave all three
# as they are. The database kill switch is a fourth, and it fails closed.
#   1. the deployment row's mode is 'live'
#   2. LIVE_TRADING_ENABLED below
#   3. ALPACA_ALLOW_LIVE below
# Two variables rather than one on purpose: the broker factory used to derive
# the third from the second, which meant a single stray flag was enough.
LIVE_TRADING_ENABLED=false
ALPACA_ALLOW_LIVE=false

# Alpaca paper credentials (Phase 3; unused today).
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
